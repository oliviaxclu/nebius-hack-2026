# Copy to .env (git-ignored). Never commit your real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Verify with `prime check`; it lists the models your key can use.
PRIME_MODEL=nvidia/nemotron-3-super-120b-a12b
# Reads the pen-check camera frames (needle caps, safety-test drop).
PRIME_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# Optional: speech to text with NVIDIA Nemotron 3 Nano Omni. Token Factory lists it as a dedicated endpoint; set its model id
# (and its base URL if it differs). Without it, voice uses the browser's speech recognition.
# PRIME_SPEECH_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning
# PRIME_SPEECH_BASE_URL=
# PRIME_SPEECH_API_KEY=        # a Nebius Serverless Endpoint's own token (docs/DEPLOY.md 3b)
# Where the local database + calendar live (default ~/.prime)
# PRIME_HOME=./.prime-data
